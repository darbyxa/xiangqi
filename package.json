{
  "name": "xiangqi-online",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time multiplayer Xiangqi (Chinese Chess) — React + TypeScript client, Express + Socket.IO server",
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n server,client -c \"#c9a24b,#e07a7a\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
