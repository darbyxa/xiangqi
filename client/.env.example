# ─── Xiangqi client configuration ─────────────────────────────────────────────
# Copy this file to `.env` (same folder). Vite only exposes variables starting with VITE_ to the browser.
# Restart `npm run dev` after changing it (and rebuild with `npm run build` for production).

# URL of the game server's Socket.IO endpoint.
#
#   (leave empty)  → connect to the same origin the page was loaded from.
#                    • dev: Vite proxies /socket.io to the server (see DEV_PROXY_TARGET)
#                    • prod / single-URL mode: the Express server serves the page, so same origin just works
#   https://abcd-1234.ngrok-free.app → point this client at a server exposed through ngrok
#                    (needed only when the client is NOT served by that server)
VITE_SERVER_URL=

# Dev only: where the Vite dev server forwards /socket.io. (Not exposed to the browser.)
DEV_PROXY_TARGET=http://localhost:3001

# Dev only: extra Host headers Vite should accept, comma-separated (e.g. a custom ngrok domain).
DEV_ALLOWED_HOSTS=
