# ─── Xiangqi server configuration ─────────────────────────────────────────────
# Copy this file to `.env` (same folder). Every value is optional; defaults are shown.

# Port the server listens on (HTTP + WebSocket)
PORT=3001

# Interface to bind. 0.0.0.0 = reachable from other devices on your network / ngrok.
HOST=0.0.0.0

# Browser origins allowed to talk to the server (comma-separated).
# Wildcards are supported for subdomains. Use * to allow everything (testing only).
# Only matters when the React app is served from a DIFFERENT origin than the server
# (e.g. the Vite dev server on :5173). Not needed in single-URL mode.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app,https://*.ngrok.io

# Serve the built React app (client/dist) from this server too.
# This is what lets a single `ngrok http 3001` tunnel carry the whole game.
SERVE_CLIENT=true

# Seconds a disconnected player has to come back before they forfeit.
# 0 = never forfeit — right for playing over days (close the app, come back later).
RECONNECT_GRACE_SECONDS=0

# Minutes after the last activity before a room with nobody connected is deleted (43200 = 30 days)
ROOM_TTL_MINUTES=43200

# true  = the room creator gets a random colour
# false = the room creator is always Red (moves first)
RANDOM_COLORS=true

# Save games to disk (in DATA_DIR) so they survive the server being stopped and started again
SAVE_GAMES=true
DATA_DIR=data

# "Your move" push notifications (needs SAVE_GAMES for its keys, and the https/ngrok address in the browser)
PUSH_NOTIFICATIONS=true
VAPID_SUBJECT=mailto:xiangqi@example.com

# Used by play_windows.bat / play_android.sh: your free ngrok domain (dashboard → Domains),
# so the game link never changes between runs. Leave empty to let ngrok choose.
NGROK_DOMAIN=
